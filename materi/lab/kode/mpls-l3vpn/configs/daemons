# Daemon FRR untuk lab mpls-l3vpn. zebra, mgmtd, dan staticd selalu berjalan.
bgpd=yes
isisd=yes
ldpd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
pimd=no
pim6d=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no

vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
