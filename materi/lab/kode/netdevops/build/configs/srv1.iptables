# Dihasilkan oleh scripts/render.py dari policy/firewall.yml. JANGAN diedit manual.
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -p icmp -j ACCEPT
-A INPUT -s 10.10.10.0/24 -p tcp --dport 80 -j ACCEPT
-A INPUT -s 10.10.10.0/24 -p tcp --dport 443 -j ACCEPT
-A INPUT -s 10.20.20.0/24 -p tcp --dport 80 -j ACCEPT
-A INPUT -s 10.20.20.0/24 -p tcp --dport 443 -j ACCEPT
-A INPUT -s 10.99.0.0/24 -p tcp --dport 80 -j ACCEPT
-A INPUT -s 10.99.0.0/24 -p tcp --dport 443 -j ACCEPT
-A INPUT -s 10.99.0.0/24 -p tcp --dport 22 -j ACCEPT
COMMIT
