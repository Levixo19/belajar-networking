{
  "name": "belajar-networking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "server": "node --watch server/index.mjs",
    "client": "vite",
    "predev": "node scripts/build-content.mjs && (docker compose up -d || echo '\u26a0 Mongo via Docker gagal \u2014 set MONGODB_URI atau jalankan mongod manual')",
    "dev": "concurrently -n server,client -c cyan,magenta \"node server/index.mjs\" \"vite\"",
    "prebuild": "node scripts/build-content.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/_muat.mjs --test \"tests/**/*.test.mjs\"",
    "panen": "node scripts/panen-pustaka.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "mongoose": "^8.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
